<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  
  <Id>e0f321dc-5f0d-40c2-91c0-c651eb5f045f</Id>
  <Version>2.0.0.1</Version>
  <ProviderName>Mesco</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  
  <DisplayName DefaultValue="CRM MESco - SharePoint"/>
  <Description DefaultValue="Wyświetla notatki CRM z SharePoint bez Power Apps"/>
  
  <!-- ⚠️ WAŻNE: Używaj raw.githubusercontent.com zamiast GitHub blob URL -->
  <IconUrl DefaultValue="https://raw.githubusercontent.com/matetiau1/CRM_MESco_POC/main/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://raw.githubusercontent.com/matetiau1/CRM_MESco_POC/main/icon-128.png"/>
  
  <SupportUrl DefaultValue="https://mescocompl.sharepoint.com"/>
  
  <!-- DOMENY ZAUFANE - bez Power Apps! -->
  <AppDomains>
    <AppDomain>https://matetiau1.github.io</AppDomain>
    <AppDomain>https://raw.githubusercontent.com</AppDomain>
    <AppDomain>https://mescocompl.sharepoint.com</AppDomain>
    <AppDomain>https://login.microsoftonline.com</AppDomain>
  </AppDomains>
  
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
      <!-- SSO - Single Sign-On -->
      <Set Name="IdentityAPI" MinVersion="1.3"/>
    </Sets>
  </Requirements>
  
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://raw.githubusercontent.com/matetiau1/CRM_MESco_POC/main/index.html"/>
        <RequestedHeight>400</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  
  <!-- ✅ ZMIENIONE: tylko ReadMailbox, nie WriteMailbox -->
  <Permissions>ReadMailbox</Permissions>
  
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
  
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
        <bt:Set Name="IdentityAPI"/>
      </bt:Sets>
    </Requirements>
    
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <SupportsSharedFolders>true</SupportsSharedFolders>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgReadGroup">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="msgReadOpenPaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                    <SupportsPinning>true</SupportsPinning>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://raw.githubusercontent.com/matetiau1/CRM_MESco_POC/main/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://raw.githubusercontent.com/matetiau1/CRM_MESco_POC/main/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://raw.githubusercontent.com/matetiau1/CRM_MESco_POC/main/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://raw.githubusercontent.com/matetiau1/CRM_MESco_POC/main/index.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="CRM"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="CRM Notes"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Otwórz panel z notatkami CRM z SharePoint"/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>